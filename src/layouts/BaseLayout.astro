---
// Shared page shell: head SEO, JSON-LD, header, <main>, footer, consent. See CLAUDE.md non-negotiables.
import '@fontsource-variable/montserrat/wght.css';
import '../styles/tokens.css';
import '../styles/theme.css';
import '../styles/overrides.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { abs, DEFAULT_OG, SITE } from '../lib/seo';

interface Props {
  title: string;
  description: string | null;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonld: object;
  bodyClass?: string;
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}
const { title, description, ogImage, ogType = 'website', jsonld, bodyClass, noindex = false, published, modified } = Astro.props;
const canonical = SITE + Astro.url.pathname;
const og = abs(ogImage || DEFAULT_OG);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={`${Astro.url.pathname === '/' ? '/index' : Astro.url.pathname.replace(/\/$/, '')}.md`} title="Markdown version for AI agents" />
    <link rel="alternate" type="application/rss+xml" title="Tim Day Construction » Feed" href={`${SITE}/feed/`} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tim Day Construction" />
    <meta property="og:image" content={og} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/wp-content/uploads/2024/12/cropped-favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2024/12/cropped-favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/12/cropped-favicon-180x180.png" />
    <meta name="msapplication-TileImage" content="/wp-content/uploads/2024/12/cropped-favicon-270x270.png" />
    <meta name="theme-color" content="#1c5156" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header />
    <slot name="top" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
