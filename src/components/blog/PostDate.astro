---
// Post date as the live theme prints it: <time datetime="2025-12-04T15:20:38+00:00"> December 4, 2025.
// WordPress stores post dates in UTC (date == date_gmt in capture/rest/posts.json); the content
// collection parses the zone-less frontmatter as local time, so read the wall-clock fields back as UTC.
import ClockIcon from './ClockIcon.astro';
interface Props { date: Date; class: string; }
const { date, class: cls } = Astro.props;
const utc = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate(), date.getHours(), date.getMinutes(), date.getSeconds()));
const iso = utc.toISOString().replace(/\.\d{3}Z$/, '+00:00');
const label = utc.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<time class={cls} datetime={iso}><ClockIcon /> {label}</time>
